    </button>

</nav>



<!-- =========================
     HERO
========================= -->

<section class="hero" id="home">

    <div class="hero-content">

        <h1>
            Explore The World
            <br>
            <span>One Journey At A Time</span>
        </h1>

        <p>
            Discover amazing destinations,
            unforgettable experiences and
            affordable travel packages.
        </p>


        <div class="search-box">

            <div class="search-item">

                <label>
                    Destination
                </label>

                <input
                    type="text"
                    id="searchDestination"
                    placeholder="Where do you want to go?"
                >

            </div>


            <div class="search-item">

                <label>
                    Travel Date
                </label>

                <input
                    type="date"
                    id="searchDate"
                >

            </div>


            <div class="search-item">

                <label>
                    Travellers
                </label>

                <input
                    type="number"
                    id="searchTravellers"
                    value="1"
                    min="1"
                >

            </div>


            <button
                class="search-button"
                onclick="searchTrips()"
            >
                Search
            </button>

        </div>

    </div>

</section>



<!-- =========================
     DESTINATIONS
========================= -->

<section id="destinations">

    <div class="section-title">

        <h2>
            Popular Destinations
        </h2>

