<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TravelEase | Travel Booking</title>

<style>

/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8f9fa;
    color: #222;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 75px;

    background: white;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 7%;

    z-index: 1000;

    box-shadow: 0 2px 15px rgba(0,0,0,0.1);
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #222;
}

.logo span {
    color: #ff6b35;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    text-decoration: none;
    color: #333;
    font-weight: 500;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #ff6b35;
}

.login-btn {
    background: #ff6b35;
    color: white;

    border: none;
    padding: 11px 22px;

    border-radius: 25px;

    cursor: pointer;

    font-size: 15px;
}

.login-btn:hover {
    background: #e85a27;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 720px;

    background:
    linear-gradient(
        rgba(0,0,0,0.5),
        rgba(0,0,0,0.5)
    ),
    url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1800&q=80");

    background-size: cover;
    background-position: center;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 100px 20px 50px;
}

.hero-content {
    width: 100%;
    max-width: 1100px;
    color: white;
}

.hero h1 {
    font-size: 62px;
    line-height: 1.15;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #ffb703;
}

.hero p {
    font-size: 20px;
    margin-bottom: 45px;
}


/* =========================
   SEARCH
========================= */

.search-box {
    background: white;
    color: #222;

    padding: 20px;

    border-radius: 15px;

    display: flex;
    gap: 15px;

    text-align: left;

    box-shadow: 0 15px 40px rgba(0,0,0,0.25);
}

.search-item {
    flex: 1;
}

.search-item label {
    display: block;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 8px;
}

.search-item input,
.search-item select {

    width: 100%;

    padding: 14px;

    border: 1px solid #ddd;

    border-radius: 8px;

    outline: none;

    font-size: 14px;
}

.search-button {

    align-self: end;

    padding: 14px 30px;

    border: none;

    border-radius: 8px;

    background: #ff6b35;

    color: white;

    font-size: 16px;

    cursor: pointer;
}

.search-button:hover {
    background: #e85a27;
}


/* =========================
   COMMON SECTION
========================= */

section {
    padding: 90px 7%;
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title h2 {
    font-size: 38px;
    margin-bottom: 10px;
}

.section-title p {
    color: #777;
}


/* =========================
   DESTINATIONS
========================= */

.destination-grid {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 30px;

    max-width: 1200px;

    margin: auto;
}

.destination-card {

    background: white;

    border-radius: 15px;

    overflow: hidden;

    box-shadow:
        0 5px 20px rgba(0,0,0,0.1);

    transition: 0.3s;
}

.destination-card:hover {
    transform: translateY(-10px);
}

.destination-card img {

    width: 100%;
    height: 240px;

    object-fit: cover;
}

.destination-info {
    padding: 22px;
}

.destination-info h3 {
    font-size: 25px;
    margin-bottom: 8px;
}

.location {
    color: #ff6b35;
    font-size: 14px;
    margin-bottom: 10px;
}

.destination-info p {
    color: #777;
    line-height: 1.6;
    margin-bottom: 18px;
}

.destination-bottom {

    display: flex;

    justify-content: space-between;

    align-items: center;
}

.price {

    font-size: 20px;

    font-weight: bold;

    color: #ff6b35;
}

.book-button {

    border: none;

    background: #ff6b35;

    color: white;

    padding: 10px 18px;

    border-radius: 7px;

    cursor: pointer;
}

.book-button:hover {
    background: #e85a27;
}


/* =========================
   PACKAGES
========================= */

.packages {
    background: #fff;
}

.package-grid {

    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 30px;
}

.package-card {

    border: 1px solid #eee;

    border-radius: 15px;

    padding: 30px;

    transition: 0.3s;
}

.package-card:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.package-card h3 {
    font-size: 24px;
    margin-bottom: 15px;
}

.package-price {

    font-size: 28px;

    color: #ff6b35;

    font-weight: bold;

    margin: 15px 0;
}

.package-card ul {

    list-style: none;

    margin-bottom: 20px;
}

.package-card li {

    margin: 10px 0;

    color: #666;
}


/* =========================
   WHY US
========================= */

.why-us {
    background: #f1f3f5;
}

.features {

    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 25px;
}

.feature {

    background: white;

    padding: 35px 20px;

    text-align: center;

    border-radius: 15px;
}

.feature-icon {

    font-size: 42px;

    margin-bottom: 15px;
}

.feature h3 {
    margin-bottom: 10px;
}

.feature p {
    color: #777;
    line-height: 1.5;
}


/* =========================
   BOOKING
========================= */

.booking-section {
    background: white;
}

.booking-container {

    max-width: 800px;

    margin: auto;

    background: #f8f9fa;

    padding: 35px;

    border-radius: 15px;

    box-shadow:
        0 5px 25px rgba(0,0,0,0.08);
}

.booking-container h2 {

    text-align: center;

    margin-bottom: 30px;
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {

    display: block;

    margin-bottom: 7px;

    font-weight: bold;
}

.form-group input,
.form-group select {

    width: 100%;

    padding: 13px;

    border: 1px solid #ddd;

    border-radius: 7px;

    font-size: 15px;
}

.submit-booking {

    width: 100%;

    padding: 14px;

    background: #ff6b35;

    color: white;

    border: none;

    border-radius: 7px;

    cursor: pointer;

    font-size: 16px;
}

.submit-booking:hover {
    background: #e85a27;
}


/* =========================
   FOOTER
========================= */

footer {

    background: #222;

    color: white;

    padding: 60px 7% 20px;
}

.footer-grid {

    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 40px;

    margin-bottom: 40px;
}

.footer-column h3 {

    margin-bottom: 15px;
}

.footer-column p {

    color: #aaa;

    line-height: 1.7;
}

.footer-column a {

    display: block;

    color: #aaa;

    text-decoration: none;

    margin: 8px 0;
}

.footer-column a:hover {
    color: white;
}

.copyright {

    text-align: center;

    border-top: 1px solid #444;

    padding-top: 20px;

    color: #aaa;
}


/* =========================
   MODAL
========================= */

.modal {

    display: none;

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    background: rgba(0,0,0,0.6);

    z-index: 2000;

    justify-content: center;

    align-items: center;
}

.modal-content {

    background: white;

    width: 90%;

    max-width: 450px;

    padding: 35px;

    border-radius: 15px;

    position: relative;

    text-align: center;
}

.close {

    position: absolute;

    top: 12px;
    right: 18px;

    font-size: 28px;

    cursor: pointer;
}

.modal-content h2 {

    margin-bottom: 20px;
}

.modal-content input {

    width: 100%;

    padding: 13px;

    margin: 8px 0;

    border: 1px solid #ddd;

    border-radius: 7px;
}

.modal-content button {

    width: 100%;

    padding: 13px;

    margin-top: 10px;

    border: none;

    background: #ff6b35;

    color: white;

    border-radius: 7px;

    cursor: pointer;
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width: 900px) {

    .nav-links {
        display: none;
    }

    .hero h1 {
        font-size: 45px;
    }

    .search-box {
        flex-direction: column;
    }

    .destination-grid,
    .package-grid {
        grid-template-columns: 1fr 1fr;
    }

    .features {
        grid-template-columns: 1fr 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}


@media(max-width: 600px) {

    .navbar {
        padding: 0 20px;
    }

    .hero {
        min-height: 800px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 16px;
    }

    .destination-grid,
    .package-grid,
    .features,
    .footer-grid {
        grid-template-columns: 1fr;
    }

    section {
        padding: 60px 20px;
    }
}

</style>
</head>


<body>


<!-- =========================
     NAVIGATION
========================= -->

<nav class="navbar">

    <div class="logo">
        Travel<span>Ease</span>
    </div>

    <ul class="nav-links">

        <li>
            <a href="#home">Home</a>
        </li>

        <li>
            <a href="#destinations">Destinations</a>
        </li>

        <li>
            <a href="#packages">Packages</a>
        </li>

        <li>
            <a href="#booking">Book Now</a>
        </li>

        <li>
            <a href="#contact">Contact</a>
        </li>

    </ul>

    <button class="login-btn" onclick="openLogin()">
