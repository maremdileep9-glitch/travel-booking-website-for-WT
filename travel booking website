                    >
                        Book
                    </button>

                </div>

            </div>

        </div>


        <!-- MUMBAI -->

        <div class="destination-card">

            <img
                src="https://images.unsplash.com/photo-1570168007204-dfb528c6958f?auto=format&fit=crop&w=900&q=80"
                alt="Mumbai"
            >

            <div class="destination-info">

                <h3>
                    Mumbai
                </h3>

                <div class="location">
                    📍 Maharashtra, India
                </div>

                <p>
                    Experience India's city of dreams,
                    beaches and amazing food.
                </p>

                <div class="destination-bottom">

                    <div class="price">
                        ₹9,999
                    </div>

                    <button
                        class="book-button"
                        onclick="selectDestination('Mumbai')"
                    >
                        Book
                    </button>

                </div>

            </div>

        </div>


        <!-- LADAKH -->

        <div class="destination-card">

            <img
                src="https://images.unsplash.com/photo-1581793745862-99fde7fa73d2?auto=format&fit=crop&w=900&q=80"
                alt="Ladakh"
            >

            <div class="destination-info">

                <h3>
                    Ladakh
                </h3>

                <div class="location">
                    📍 Ladakh, India
                </div>

                <p>
                    Discover breathtaking mountains,
                    lakes and adventurous roads.
                </p>

                <div class="destination-bottom">

                    <div class="price">
                        ₹21,999
                    </div>

                    <button
                        class="book-button"
                        onclick="selectDestination('Ladakh')"
                    >
                        Book
                    </button>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================
     PACKAGES
========================= -->

<section class="packages" id="packages">

    <div class="section-title">

        <h2>
            Travel Packages
        </h2>

        <p>
            Choose a package that suits your journey
        </p>

    </div>


    <div class="package-grid">


        <div class="package-card">

